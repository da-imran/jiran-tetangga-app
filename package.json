{
  "name": "jiran-tetangga-app",
  "version": "1.0.0",
  "license": "ISC",
  "private": true,
  "description": "JiranTetangga - Monorepo for Backend API and Frontend Web App",
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" --parallel --if-present run dev",
    "dev:api": "DATABASE_URL=\"${DATABASE_URL:-}\" pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/jiran-tetangga run dev",
    "build": "pnpm --filter \"./packages/**\" --if-present run build",
    "typecheck": "pnpm --filter \"./packages/**\" --if-present run typecheck",
    "lint": "pnpm --filter \"./packages/**\" --if-present run lint",
    "test": "pnpm --filter \"./packages/**\" --if-present run test"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@tailwindcss/oxide-darwin-arm64": "^4.3.1",
    "lightningcss-darwin-arm64": "^1.32.0"
  }
}
